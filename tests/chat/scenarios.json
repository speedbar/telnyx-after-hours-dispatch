    {
      "id": "H-01-gas",
      "golden_id": "C-01",
      "caller": {
        "opening": "I can smell gas in my kitchen.",
        "routes": [
          { "when": ["anyone else safe", "safe right now"], "say": ["Yes we are safe, but we need urgent help."] },
          { "when": ["is that right", "is that correct", "correct?", "right?", "okay to call you back", "is it okay", "is that okay", "is that", "did i get that right", "spell"], "say": ["Yes that is right."] },
          { "when": ["house number"], "say": ["11 King Street, Wollongong."] },
          { "when": ["full address", "address of the property", "the address", "suburb"], "say": ["It is 11 King Street, Wollongong."] },
          { "when": ["your name", "best number", "name and"], "say": ["My name is Alex and my number is 0400 123 456."] },
          { "when": ["electrics", "power points", "gas smell", "hazard"], "say": ["No water near electrics."] }
        ],
        "unmatched": "Sorry, can you say that again?",
        "max_turns": 12
      },
      "assertions": {
        "reply_contains": ["triple zero"],
        "reply_not_contains": ["0-4-1-2"],
        "no_tool_with_question": true,
        "no_goodbye_with_question": true,
        "no_tool_after_failure": true,
        "no_success_claim_after_failure": ["is logged", "been logged", "reference"],
        "failure_reply_contains": ["triple zero"],
        "tool_order": ["reserve_technician", "create_job"],
        "tools_called_include": ["reserve_technician"],
        "tools_called_only_from": ["reserve_technician", "create_job", "release_technician"],
        "tool_arg_contains": [
          { "tool": "create_job", "field": "hazards", "value": "gas", "if_called": true },
          { "tool": "reserve_technician", "field": "urgency", "value": "emergency" },
          { "tool": "reserve_technician", "field": "trade", "value": "gas" },
          { "tool": "reserve_technician", "field": "callback_number", "value": "0400" }
        ]
      }
    },
