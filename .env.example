# Names only. Never put real values in this file.
# Real values live in your shell (TELNYX_API_KEY), in `telnyx-edge secrets add` (the rest), or in OpenCode's credential store.
TELNYX_API_KEY=
# Webhook signature key. For local `telnyx-edge dev`, export the TEST public key printed by scripts/sign.ts under this same name.
TELNYX_PUBLIC_KEY=
MCP_TOKEN=
# Bearer token for the /admin routes
ADMIN_TOKEN=
LOG_SALT=
# JSON map of technician id to E.164 number, e.g. {"tech-01":"+61400000000"}
TECH_PHONES_JSON=
# D20 ring: Call Control App ID (dial connection) and the caller-ID number for outbound rings (E.164)
VOICE_CONNECTION_ID=
DISPATCH_FROM_NUMBER=
# Human escalation number spoken when dispatch cannot proceed (E.164 or digits; never a real number in this file)
FALLBACK_NUMBER=
# D20b-1 accept SMS: messaging profile id (profile "dispatch-sms", has the Alpha sender) and the Alpha sender text
MESSAGING_PROFILE_ID=
SMS_FROM=
# Non-secret settings (also set under [env_vars] in telnyx.toml later)
# RING_INLINE: unset or 1 starts the ring inline from create_job (default); 0 = old alarm path only.
RING_INLINE=1
# Optional TTS voice id for the technician ring (set this; the speak command may require a voice (VERIFY)).
RING_VOICE=
# TTS language for the technician ring
RING_TTS_LANGUAGE=
# Delay before the ring starts, milliseconds (alarm fallback only)
RING_START_DELAY_MS=
# Reservation hold TTL per ring attempt, seconds
RING_HOLD_TTL_S=
# Seconds a technician stays busy after a ring (default 1800)
DISPATCH_BUSY_S=
# Per-technician cooldown between rings, seconds (default 60, 0 disables)
RING_COOLDOWN_S=
# Max rings per technician per day (default 20)
RING_DAILY_CAP=
# Comma-separated phone prefixes the dialer may ring (default +61)
ALLOWED_DIAL_PREFIXES=
# Days a job record is kept before cleanup
JOB_RETENTION_DAYS=
DISPATCH_HOLD_TTL_S=90
SMS_DAILY_CAP=20
# D20c: optional manager alert number when nobody accepts. Digits with country code only, e.g. 61400000000 (a leading + is not handled yet, BUG-024); unset = no alert
MANAGER_PHONE=
# not implemented yet
LOG_LEVEL=info
